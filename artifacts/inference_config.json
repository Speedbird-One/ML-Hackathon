{
  "model_file": "lgbm.joblib",
  "model_name": "LightGBM",
  "features": [
    "dist_m",
    "along_frac",
    "arc_len_m",
    "speed_mps",
    "cos_heading",
    "dist_rank",
    "dist_minus_min",
    "n_cand"
